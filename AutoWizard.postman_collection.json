	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"birthdate\": \"1990-01-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Register a new user"
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login and get JWT token"
					}
				}
			]
		},
		{
			"name": "Vehicles",
			"item": [
				{
					"name": "Create Vehicle",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"Car\",\n    \"brand\": \"Toyota\",\n    \"model\": \"Corolla\",\n    \"licensePlate\": \"AB123CD\",\n    \"vin\": \"1HGCM82633A123456\",\n    \"mileage\": 50000,\n    \"registrationYear\": 2020,\n    \"fuel\": \"BENZINA\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/vehicles",
							"host": ["{{base_url}}"],
							"path": ["api", "vehicles"]
						},
						"description": "Create a new vehicle"
					}
				},
				{
					"name": "Get Vehicle by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/vehicles/{{vehicle_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "vehicles", "{{vehicle_id}}"]
						},
						"description": "Get details of a specific vehicle by ID"
					}
				},
				{
					"name": "Update Vehicle Mileage",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/vehicles/{{vehicle_id}}/mileage?newMileage=60000",
							"host": ["{{base_url}}"],
							"path": ["api", "vehicles", "{{vehicle_id}}", "mileage"],
							"query": [
								{
									"key": "newMileage",
									"value": "60000"
								}
							]
						},
						"description": "Update vehicle mileage"
					}
				},
				{
					"name": "Delete Vehicle",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/vehicles/{{vehicle_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "vehicles", "{{vehicle_id}}"]
						},
						"description": "Delete a vehicle"
					}
				},
				{
					"name": "Get All Vehicles",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/vehicles",
							"host": ["{{base_url}}"],
							"path": ["api", "vehicles"]
						},
						"description": "Get all vehicles for the current user"
					}
				}
			]
		},
		{
			"name": "Documents",
			"item": [
				{
					"name": "Upload Document",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "/path/to/your/file.pdf"
								},
								{
									"key": "type", "value": "LIBRETTO_DI_CIRCOLAZIONE",
									"type": "text",
									"description": "Document type (LIBRETTO, ASSICURAZIONE, BOLLO, REVISIONE, ALTRO)"
								},
								{
									"key": "vehicleId",
									"value": "{{vehicle_id}}",
									"type": "text"
								},
								{
									"key": "expiryDate",
									"value": "2024-12-31",
									"type": "text",
									"description": "Optional expiry date (YYYY-MM-DD)"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/documents/upload",
							"host": ["{{base_url}}"],
							"path": ["api", "documents", "upload"]
						},
						"description": "Upload a new document for a vehicle. Document types: LIBRETTO, ASSICURAZIONE, BOLLO, REVISIONE, ALTRO"
					}
				},
				{
					"name": "Delete Document",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/documents/{{document_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "documents", "{{document_id}}"]
						},
						"description": "Delete a document by ID"
					}
				},
				{
					"name": "Get Vehicle Documents",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/documents/vehicle/{{vehicle_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "documents", "vehicle", "{{vehicle_id}}"]
						},
						"description": "Get all documents for a specific vehicle. Returns document metadata including type, upload date, and expiry date if applicable."
					}
				},
				{
					"name": "Get Document File",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/documents/{{document_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "documents", "{{document_id}}"]
						},
						"description": "Download the actual document file by document ID"
					}
				}
			]
		},
		{
			"name": "Maintenance Tasks",
			"item": [
				{
					"name": "Create Task",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Cambio Olio\",\n    \"description\": \"Cambio olio motore e filtro\",\n    \"scheduledDate\": \"2027-04-01T10:00:00\",\n    \"priority\": \"MEDIUM\",\n    \"scheduledMileage\": 60000,\n    \"notes\": \"Usare olio sintetico 5W-30\",\n    \"vehicleId\": {{vehicle_id}}\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/maintenance-tasks",
							"host": ["{{base_url}}"],
							"path": ["api", "maintenance-tasks"]
						},
						"description": "Create a new maintenance task for a vehicle. Required fields: title, description, scheduledDate, priority, scheduledMileage, vehicleId. Optional fields: notes."
					}
				},
				{
					"name": "Complete Task",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"actualCost\": 210.00,\n    \"completionMileage\": 61200,\n    \"completionDate\": \"2026-01-15T17:30:00\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/maintenance-tasks/{{task_id}}/complete",
							"host": ["{{base_url}}"],
							"path": ["api", "maintenance-tasks", "{{task_id}}", "complete"]
						},
						"description": "Mark a task as done. Required: completionMileage. Optional: actualCost, completionDate (default now). Raises the vehicle mileage if higher."
					}
				},
